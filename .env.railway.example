# =============================================================================
# CollabStudy — Railway Environment Variables
# =============================================================================
# Copy the relevant section into each Railway service's "Variables" tab.
# Replace all <placeholder> values with your real values.
#
# How to generate JWT_SECRET:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =============================================================================


# =============================================================================
# SERVICE: api  (NestJS Backend)
# =============================================================================

NODE_ENV=production
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────
# Use Railway's reference variable — it auto-populates from the Postgres plugin.
# In Railway dashboard, set the value literally as: ${{Postgres.DATABASE_URL}}
DATABASE_URL=${{Postgres.DATABASE_URL}}

# ── Redis ─────────────────────────────────────────────────────────────────────
# Use Railway's reference variables from the Redis plugin.
# In Railway dashboard, set each value as shown:
REDIS_HOST=${{Redis.RAILWAY_SERVICE_REDIS_URL}}
REDIS_PORT=6379
REDIS_PASSWORD=${{Redis.RAILWAY_REDIS_PASSWORD}}

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=<generate_with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
JWT_EXPIRES_IN=7d

# ── CORS — must match your deployed web service URL exactly ───────────────────
CORS_ORIGIN=https://<your-web-service>.up.railway.app

# ── Email — Resend (Sandbox mode: auto-verify enabled, emails suppressed) ─────
RESEND_API_KEY=re_HzeUCNm4_Ht7jmAEkEMdYJnmzzywHwqMt
RESEND_FROM_EMAIL=onboarding@resend.dev
APP_NAME=CollabStudy

# ── Cloudflare Turnstile (using test bypass key for now) ─────────────────────
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Google Gemini AI (optional — degrades gracefully if absent) ───────────────
GEMINI_API_KEY=<your_gemini_api_key>

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>
# Set this to your Railway API service URL:
GOOGLE_CALLBACK_URL=https://<your-api-service>.up.railway.app/auth/google/callback
FRONTEND_URL=https://<your-web-service>.up.railway.app

# ── S3 Storage (optional — falls back to local disk if absent) ────────────────
# WARNING: Local disk uploads are ephemeral on Railway (lost on redeploy).
# Strongly recommended: set up Cloudflare R2, Supabase Storage, or AWS S3.
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=<your_access_key_id>
AWS_SECRET_ACCESS_KEY=<your_secret_access_key>
AWS_S3_BUCKET_NAME=<your_bucket_name>
AWS_S3_ENDPOINT=

# ── Sentry (optional) ─────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=collabstudy-api

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info


# =============================================================================
# SERVICE: web  (Next.js Frontend)
# =============================================================================

NODE_ENV=production
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# ── API URLs — set to your Railway API service public URL ─────────────────────
# Server-side requests (from Next.js server components/routes):
NEXT_PUBLIC_API_URL=https://<your-api-service>.up.railway.app
# WebSocket endpoint (accessed from the browser):
NEXT_PUBLIC_WS_URL=https://<your-api-service>.up.railway.app

# ── Cloudflare Turnstile site key (public — safe to expose) ──────────────────
# Use test site key for now: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ── Sentry (optional) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
