{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@collabstudy/shared": ["./packages/shared/src"],
      "@collabstudy/db": ["./packages/db/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}
