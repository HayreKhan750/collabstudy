# =============================================================================
# CollabStudy Web — Environment Variables
# =============================================================================
# IMPORTANT: NEXT_PUBLIC_* variables are baked into the JS bundle at BUILD TIME.
# You MUST set these in Railway (or your CI environment) BEFORE the build runs.
# Changing them in Railway after a deploy requires a full redeploy to take effect.
# =============================================================================

# URL of the NestJS API — no trailing slash
# Local dev:   http://localhost:4000
# Production:  https://your-api.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cloudflare Turnstile site key (use the test key below for local dev)
# Get a real key at: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Sentry DSN (optional — leave blank to disable error tracking)
NEXT_PUBLIC_SENTRY_DSN=
