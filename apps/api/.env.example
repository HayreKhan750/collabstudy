# =============================================================================
# CollabStudy API — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values before starting the server.
#   cp .env.example .env
#
# ⚠  Never commit .env to version control. It is already in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Required)
# PostgreSQL connection string. The database must have pgvector enabled.
# For local development with Docker: use the values below as-is.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://collabstudy:collabstudy123@localhost:5432/collabstudy

# -----------------------------------------------------------------------------
# REDIS (Required)
# Used for: BullMQ job queues, rate-limiting throttler, AI digest cache,
#           Socket.io Redis adapter (horizontal scaling).
# For local development with Docker: use the values below as-is.
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: set if your Redis instance requires authentication
# REDIS_PASSWORD=your_redis_password_here

# -----------------------------------------------------------------------------
# JWT / AUTHENTICATION (Required)
# Must be at least 32 random characters. Use a cryptographically secure value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_use_a_long_random_secret_at_least_32_chars

# JWT access token expiry (e.g. 7d, 24h, 1h). Default: 7d
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# GOOGLE GEMINI AI (Optional — degrades gracefully if absent)
# Required in production for: AI chat summaries, message embeddings,
#                              semantic search, smart notification digest.
# Get a key at: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# S3-COMPATIBLE OBJECT STORAGE (Optional — falls back to local disk if absent)
# Supported providers: AWS S3, Supabase Storage, Cloudflare R2, MinIO.
# If these are not set, uploaded files are saved to apps/api/uploads/ locally.
# -----------------------------------------------------------------------------
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_S3_BUCKET_NAME=your_bucket_name_here

# Custom endpoint — required for non-AWS providers:
#   Supabase:  https://<project-ref>.supabase.co/storage/v1/s3
#   R2:        https://<account-id>.r2.cloudflarestorage.com
#   MinIO:     http://localhost:9000
# Leave blank to use standard AWS S3 endpoints.
AWS_S3_ENDPOINT=

# -----------------------------------------------------------------------------
# SERVER (Optional — sensible defaults provided)
# -----------------------------------------------------------------------------
# Port the API HTTP server listens on
PORT=4000

# Runtime environment: development | staging | production
NODE_ENV=development

# Allowed CORS origin for the frontend application.
# Required in production — must match your deployed frontend URL exactly.
# In development, localhost:3000 is always allowed.
# Example: https://app.collabstudy.com
CORS_ORIGIN=http://localhost:3000

# Pino log level: trace | debug | info | warn | error | fatal
# Defaults to "debug" in development, "info" in production.
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# SENTRY (Optional — error tracking and performance monitoring)
# Get your DSN at: https://sentry.io → Project Settings → Client Keys (DSN)
# If not set, Sentry is silently disabled (a warning is logged in production).
# -----------------------------------------------------------------------------
SENTRY_DSN=

# Sentry Auth Token — required ONLY for source map uploads during CI builds.
# Create at: https://sentry.io/settings/account/api/auth-tokens/
# Needs scopes: project:read, project:releases, org:read
SENTRY_AUTH_TOKEN=

# Sentry organization slug and project slug (for source map uploads in CI)
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=collabstudy-api

# Git SHA — auto-injected by CI; used as Sentry release identifier
# GIT_SHA=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
FRONTEND_URL=http://localhost:3000
