{
  "name": "collabstudy",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Real-Time Academic Collaboration Platform",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @collabstudy/web dev",
    "dev:api": "pnpm --filter @collabstudy/api start:dev",
    "dev:ai": "cd apps/ai && source venv/bin/activate && uvicorn main:app --reload --port 8000",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "db:setup": "cd packages/db && pnpm prisma db push && pnpm prisma generate",
    "db:studio": "pnpm --filter @collabstudy/db db:studio",
    "build": "turbo run build",
    "build:web": "pnpm --filter @collabstudy/web build",
    "build:api": "pnpm --filter @collabstudy/api build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @collabstudy/db db:generate",
    "db:push": "pnpm --filter @collabstudy/db db:push",
    "db:migrate": "pnpm --filter @collabstudy/db db:migrate",
    "db:migrate:deploy": "prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema=packages/db/prisma/schema.prisma",
    "db:seed": "pnpm --filter @collabstudy/db db:seed",
    "docker:logs": "docker-compose logs -f",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:full": "pnpm clean && rm -rf .turbo && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "test:load:ws": "k6 run load-tests/ws-connections.js",
    "test:load:messages": "k6 run load-tests/http-messages.js",
    "test:load:uploads": "k6 run load-tests/file-uploads.js",
    "test:load:all": "k6 run load-tests/ws-connections.js && k6 run load-tests/http-messages.js && k6 run load-tests/file-uploads.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "turbo": "^1.11.3",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.1",
  "dependencies": {
    "framer-motion": "^12.34.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
